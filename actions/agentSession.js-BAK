// actions/agentSession.js — AI Ventures Session Card
// Manages the "AI Agents Session" card in the founder dashboard.
// Calls the Railway API server to create/end sessions.

import { CONFIG }    from "../config.js";
import { APP_STATE } from "../utils/state.js";

const API = CONFIG.SESSION_MANAGER_URL;

// ─── Render session card ──────────────────────────────────────────────────────
// Called by updateUI() when founder is connected.
// Injects the card into #session-card-container.

export function renderSessionCard() {
  const container = document.getElementById("session-card-container");
  if (!container) return;

  const session = APP_STATE.session;

  if (!session) {
    container.innerHTML = renderInactiveCard();
  } else {
    container.innerHTML = renderActiveCard(session);
    startCountdown(session.expiresAt);
  }

  attachSessionListeners();
}

// ─── Inactive state ───────────────────────────────────────────────────────────

function renderInactiveCard() {
  const hasAgents = (APP_STATE.agentBadges || []).filter(b => b.active).length > 0;

  return `
    <div class="card session-card" id="session-card">
      <div class="card-header">
        <span class="card-title">🤖 AI Agents</span>
        <span class="session-status inactive">● Offline</span>
      </div>

      ${!hasAgents ? `
        <p style="font-size:13px;color:#555;margin:0 0 16px;">
          Mint at least one agent badge before starting a session.
        </p>` : `
        <p style="font-size:13px;color:#8b949e;margin:0 0 16px;">
          Start a 2-hour session to activate your agents on Telegram.
          They will receive a group where you can give them instructions.
        </p>`
      }

      <button id="btn-start-session"
        ${!hasAgents ? "disabled" : ""}
        style="width:100%;padding:12px;border-radius:8px;
          background:${hasAgents ? "#276ff5" : "#1a1a2e"};
          color:${hasAgents ? "white" : "#555"};
          border:${hasAgents ? "none" : "1px solid #30363d"};
          cursor:${hasAgents ? "pointer" : "not-allowed"};
          font-size:15px;font-weight:600;">
        ${hasAgents ? "🚀 Start Agent Session — 2 hours" : "No agents minted yet"}
      </button>
    </div>`;
}

// ─── Active state ─────────────────────────────────────────────────────────────

function renderActiveCard(session) {
  const agentList = (session.agents || []).map(a => `
    <div style="display:flex;justify-content:space-between;align-items:center;
      padding:6px 0;border-bottom:1px solid #1f2937;">
      <span style="font-size:12px;color:#8b949e;">${a.role}</span>
      <span style="font-size:12px;color:#e6edf3;">${a.name}</span>
    </div>`).join("");

  return `
    <div class="card session-card" id="session-card">
      <div class="card-header">
        <span class="card-title">🤖 AI Agents</span>
        <span class="session-status active">● Active</span>
      </div>

      <div style="margin-bottom:12px;">
        ${agentList}
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;
        padding:8px;border-radius:8px;background:#0a0f1a;border:1px solid #1f2937;
        margin-bottom:12px;">
        <span style="font-size:12px;color:#8b949e;">Session ends in</span>
        <span id="session-countdown" style="font-size:14px;font-weight:600;color:#276ff5;">
          --:--:--
        </span>
      </div>

      <a id="btn-join-telegram"
        href="${session.inviteLink}"
        target="_blank"
        style="display:block;width:100%;padding:12px;border-radius:8px;
          background:#276ff5;color:white;border:none;cursor:pointer;
          font-size:15px;font-weight:600;text-align:center;
          text-decoration:none;box-sizing:border-box;margin-bottom:8px;">
        💬 Join your agents on Telegram →
      </a>

      <button id="btn-end-session"
        style="width:100%;padding:10px;border-radius:8px;
          background:transparent;color:#555;
          border:1px solid #30363d;cursor:pointer;font-size:13px;">
        End Session
      </button>
    </div>`;
}

// ─── Event listeners ──────────────────────────────────────────────────────────

function attachSessionListeners() {
  document.getElementById("btn-start-session")?.addEventListener("click", startSession);
  document.getElementById("btn-end-session")?.addEventListener("click",   endSession);
}

// ─── Start session ────────────────────────────────────────────────────────────

async function startSession() {
  const btn = document.getElementById("btn-start-session");
  if (btn) { btn.disabled = true; btn.textContent = "⏳ Starting..."; }

  try {
    const activeBadges = (APP_STATE.agentBadges || []).filter(b => b.active);

    const body = {
      companyAddress:      APP_STATE.componentAddress,
      founderBadgeAddress: APP_STATE.founderBadgeAddress,
      agentBadges: activeBadges.map(b => ({
        badgeId:   b.id,
        agentName: b.agent_name,
        role:      b.role,
      })),
      mode:              "demo",
      founderTelegramId: CONFIG.FOUNDER_TELEGRAM_ID ?? "",
    };

    const res = await fetch(`${API}/session/create`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });

    if (!res.ok) {
      const err = await res.json();
      throw new Error(err.error || "Failed to create session");
    }

    const session = await res.json();

    // Store in app state
    APP_STATE.session = session;

    // Update agent badges with their new accounts
    if (session.agents) {
      session.agents.forEach(sa => {
        const badge = APP_STATE.agentBadges.find(b => b.id === sa.badgeId);
        if (badge) badge.account = sa.address;
      });
    }

    // Re-render card
    renderSessionCard();

  } catch (err) {
    console.error("[agentSession] startSession error:", err);
    alert(`Failed to start session: ${err.message}`);
    if (btn) { btn.disabled = false; btn.textContent = "🚀 Start Agent Session — 2 hours"; }
  }
}

// ─── End session ──────────────────────────────────────────────────────────────

async function endSession() {
  if (!APP_STATE.session?.sessionId) return;
  if (!confirm("End the current agent session?")) return;

  try {
    await fetch(`${API}/session/end/${APP_STATE.session.sessionId}`, {
      method: "POST",
    });
  } catch (err) {
    console.error("[agentSession] endSession error:", err);
  }

  APP_STATE.session = null;
  renderSessionCard();
}

// ─── Countdown timer ──────────────────────────────────────────────────────────

let countdownTimer = null;

function startCountdown(expiresAt) {
  if (countdownTimer) clearInterval(countdownTimer);

  function tick() {
    const el = document.getElementById("session-countdown");
    if (!el) { clearInterval(countdownTimer); return; }

    const remaining = new Date(expiresAt) - new Date();
    if (remaining <= 0) {
      el.textContent = "Expired";
      APP_STATE.session = null;
      clearInterval(countdownTimer);
      setTimeout(renderSessionCard, 1000);
      return;
    }

    const h = Math.floor(remaining / 3_600_000);
    const m = Math.floor((remaining % 3_600_000) / 60_000);
    const s = Math.floor((remaining % 60_000) / 1000);
    el.textContent = `${String(h).padStart(2,"0")}:${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;
  }

  tick();
  countdownTimer = setInterval(tick, 1000);
}
